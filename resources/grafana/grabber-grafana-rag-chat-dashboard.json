          "content": "<div class=\"grid\">\n    <div class=\"grid-div\">\n        <textarea id=\"prompt\" placeholder=\"ask your questions here ...\"></textarea>\n        <div>\n            <button onclick=\"submitPrompt()\">Submit</button>\n        </div>\n    </div>\n    <div class=\"grid-div\">\n        <input type=\"text\" id=\"document-link\" placeholder=\"Document Link\"/>\n        <div>\n            <button onclick=\"submitDocumentLink()\">Submit</button>\n            <span id=\"documentlink-text\"></span>\n        </div>\n    </div>\n</div>\n<div id=\"chat\">\n    <div id=\"placeholder-chat\">\n        <div class=\"left-chat\">\n            <p class=\"chat-question\">\n                First Question?\n            </p>\n        </div>    \n        <div class=\"right-chat\">\n            <p class=\"chat-answer\">\n                Answer to the first question.\n            </p>\n        </div>\n    </div>\n</div>\n<script>\n\n    //var chatUrl = \"http://localhost:10001/api/v1/llm/rag/S2/chat?question=\"; // URL to the chat service\n\n    //var documentUrl = \"http://localhost:10001/api/v1/llm/rag/S2/document?link=\"; // URL to the document service\n\n    var chatUrl = \"http://localhost:8001/api/v1/llm/rag/${RAGServiceID}/chat?question=\"; // URL to the chat service\n\n    var documentUrl = \"http://localhost:8001/grabber/api/v1/llm/rag/${RAGServiceID}/document?link=\"; // URL to the document service\n\n    function submitPrompt(){\n        var prompt = document.getElementById(\"prompt\").value;\n        fetch(chatUrl + prompt)\n            .then((response) => response.text())\n            .then((text) => appendChat(prompt, text));\n    }\n\n    function appendChat(question, answer){\n        console.debug(question + \" --> \" + answer);\n        var chatDiv = document.getElementById(\"chat\");\n        var placeholderDiv = document.getElementById(\"placeholder-chat\");\n        if (placeholderDiv != undefined) {\n            chatDiv.removeChild(placeholderDiv);\n        }\n        var questionDiv = document.createElement(\"div\");\n        questionDiv.className = \"left-chat\";\n        var questionText = document.createElement(\"p\");\n        questionText.className = \"chat-question\";\n        questionText.innerHTML = question;\n        questionDiv.appendChild(questionText);\n        chatDiv.appendChild(questionDiv);\n        var answerDiv = document.createElement(\"div\");\n        answerDiv.className = \"right-chat\";\n        var answerText = document.createElement(\"p\");\n        answerText.className = \"chat-answer\";\n        answerText.innerHTML = answer;\n        answerDiv.appendChild(answerText);\n        chatDiv.appendChild(answerDiv);\n        chatDiv.scrollTop = chatDiv.scrollHeight;\n        var prompt = document.getElementById(\"prompt\");\n        prompt.value = \"\";\n    }\n\n    function submitDocumentLink(){\n        var documentLink = document.getElementById(\"document-link\").value;\n        console.debug(documentLink);\n        documentLink = encodeURI(documentLink);\n        console.debug(documentLink);\n        var documentLinkText = document.getElementById(\"documentlink-text\");\n        documentLinkText.innerHTML = \"\";\n        var requestOptions = {\n            method: \"PUT\",\n            headers: { \"Content-Type\": \"text/plain\" }\n        };\n        fetch(documentUrl + documentLink, requestOptions)\n            .then((response) => response.text())\n            .then((text) => createDocumentLinkText(text));\n    }\n\n    function createDocumentLinkText(text){\n        var documentLinkText = document.getElementById(\"documentlink-text\");\n        if (String(text).toLowerCase() == \"true\"){\n            documentLinkText.innerHTML = \"a new document was added to RAGEngine.\";\n        } else {\n            documentLinkText.innerHTML = \"the document could not be added.\";\n        }\n        documentLinkText.value = \"\";\n    }\n\n</script>\n\n<style>\n\n    #chat {\n        width: 100%;\n        color: #000000;\n        overflow-y: scroll;\n        max-height: 400px;\n    }\n\n    #prompt {\n        width: 100%;\n    }\n\n    .grid {\n        display: grid;\n        grid-template-columns: 70% 30%;\n        gap: 10px;\n    }\n\n    .grid-div {\n        display: grid;\n        grid-auto-flow: rows;\n    }\n\n    .left-chat {\n        text-align: left;\n    }\n\n    .right-chat {\n        text-align: right;\n    }\n\n    .chat-question {\n        background-color: #93c47d;\n        padding: 10px;\n        margin: 10px;\n        border-radius: 10px;\n        width: 90%;\n        display:inline-block;\n        text-align: left;\n    }\n\n    .chat-answer {\n        background-color: #6fa8dc;\n        padding: 10px;\n        margin: 10px;\n        border-radius: 10px;\n        width: 90%;\n        display:inline-block;\n        text-align: right;\n    }\n\n</style>",
          "mode": "html"
        },
